---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/stamp-duty-calculator/" title="Stamp duty calculator for England, Northern Ireland, Scotland and Wales" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the UK stamp duty calculator: SDLT, LBTT and LTT" description="Embed the three-nation stamp duty calculator on your own website for free: one iframe code, no sign-up, no tracking, rates kept up to date for England, Scotland and Wales." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the stamp duty calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy one line of code. Your visitors get SDLT, LBTT and LTT with every surcharge, and the rates stay current because they are updated here.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not alter the frame, and use it as provided, without warranty. The iframe sets no cookie and sends nothing about your visitors to us.</p>
    <p>Estate agents, conveyancers, housing associations and property journalists use it most. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/stamp-duty-calculator/" title="Stamp duty calculator for England, Northern Ireland, Scotland and Wales" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
